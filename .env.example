# ---------------------------------------------------------------------------
# Brier — example environment. COPY to `.env` and fill in locally.
# `.env` is gitignored. NEVER commit a real key.
# ---------------------------------------------------------------------------

# Which SP1 prover to use. One of: mock | local | network
#
#   mock    - no real proving, instant, zero cost. Default for unit tests.
#   local   - real proof on this machine, zero cost, needs 16+ cores / 16GB RAM
#             for Groth16 (see solana/docs/PHASE0_PROVING_STACK.md).
#   network - Succinct Prover Network. COSTS REAL $PROVE PER REQUEST.
#
# Defaults to `mock` when unset. `network` is never selected by any default,
# test, or CI path — it must be opted into per run by a human.
SP1_PROVER_MODE=mock

# Requester key for `network` mode ONLY. Leave EMPTY here.
#
# This file is committed, so it must never contain a value. Set it in your
# local `.env`, or export it in your shell for a single command.
# See docs/prover-network-setup.md for the manual steps to create and fund a
# key — that process is performed by you, not by any script in this repo.
NETWORK_PRIVATE_KEY=

# Optional Succinct network overrides. Leave blank to use the SDK defaults.
NETWORK_RPC_URL=

# Where the network-mode cost log is written (JSONL, one record per request).
# Only written in `network` mode. Never contains key material.
SP1_COST_LOG=artifacts/prover/network_costs.jsonl

# ---------------------------------------------------------------------------
# EVM demo (local Anvil only). The value below is Anvil's first well-known
# development account, published in Foundry's own documentation. It holds no
# real funds on any live network and is safe to commit for local testing.
# ---------------------------------------------------------------------------
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
