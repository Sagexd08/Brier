__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Raw data is downloaded by the pipeline (UCI; redistribution not assumed)
data/raw/*
!data/raw/.gitkeep

# Large regenerable ZK artefacts. Regenerate with scripts/31_zk_prove.py.
# The proving keys are ~138 MB EACH and the SRS is 4 MB; none belong in git.
**/*.srs
**/*.pk
**/pk.key
**/*.compiled
artifacts/zk/srs/
artifacts/zk/demo/

# Vendored binaries (download via scripts/00_setup_tools.sh)
tools/*.exe
tools/*.tar.gz

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/gasreport.txt
contracts/lib/

# Rust / Anchor / SP1 build artefacts
target/
**/target/
solana/.anchor/
solana/test-ledger/
**/*.rs.bk

# Secrets. NEVER commit a real key.
# .env.example is the only env file that may be tracked, and it is empty.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
# NOTE: do NOT un-ignore pk.key -- EZKL proving keys are 132 MiB each.
solana/**/keypair*.json

# Node / Next.js. node_modules was committed by mistake in b01e9a7 --
# it carries a 176 MB platform binary (@next/swc-win32-x64-msvc) that
# exceeds GitHub's 100 MB file limit. Everything here is reproducible
# from package-lock.json via `npm ci`.
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
next-env.d.ts
npm-debug.log*
yarn-error.log*
